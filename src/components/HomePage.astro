---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from './Navbar';
import Hero from './Hero.astro';
import About from './About.astro';
import TechStack from './TechStack.astro';
import Experience from './Experience.astro';
import Projects from './Projects.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import { profile } from '@/data/profile';
import { languages, type Lang } from '@/i18n/ui';
import { getHomeUrl, getOtherLang, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const otherLang = getOtherLang(lang);

const links = [
  { id: 'about', label: t('nav.about') },
  { id: 'stack', label: t('nav.stack') },
  { id: 'experience', label: t('nav.experience') },
  { id: 'projects', label: t('nav.projects') },
  { id: 'contact', label: t('nav.contact') },
];
---

<BaseLayout lang={lang}>
  <Navbar
    client:load
    name={profile.name}
    initials={profile.initials}
    homeHref={getHomeUrl(lang)}
    links={links}
    altLang={{ href: getHomeUrl(otherLang), code: otherLang, label: languages[otherLang] }}
    cta={{ href: '#contact', label: t('hero.ctaContact') }}
    labels={{
      menu: t('nav.menu'),
      close: t('nav.close'),
      language: t('nav.language'),
    }}
  />
  <main id="main">
    <Hero lang={lang} />
    <About lang={lang} />
    <TechStack lang={lang} />
    <Experience lang={lang} />
    <Projects lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</BaseLayout>
