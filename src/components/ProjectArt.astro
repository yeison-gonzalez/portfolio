---
import PixelIcon from './icons/PixelIcon';
import type { Project } from '@/data/projects';

interface Props {
  art: Project['art'];
}

// Concept illustrations drawn in the four LCD shades, shown until a project ships with real screenshots.
const { art } = Astro.props;

interface CodeLine {
  indent: number;
  parts: [shade: 0 | 1 | 2, width: number][];
  flagged?: boolean;
}

const shade = ['var(--color-lcd-0)', 'var(--color-lcd-1)', 'var(--color-lcd-2)'];

const codeLines: CodeLine[] = [
  { indent: 0, parts: [[0, 14], [1, 22], [0, 18]] },
  { indent: 1, parts: [[0, 10], [1, 30]] },
  { indent: 1, parts: [[1, 16], [0, 12], [1, 20]], flagged: true },
  { indent: 2, parts: [[0, 24], [1, 16]] },
  { indent: 2, parts: [[1, 12], [0, 28]] },
  { indent: 1, parts: [[0, 8], [1, 20]], flagged: true },
  { indent: 0, parts: [[0, 6]] },
];

const bars = [38, 62, 45, 80, 56, 92, 70];

const modules = [
  { name: 'auth', ms: 38, icon: 'lock' },
  { name: 'cart', ms: 42, icon: 'cart' },
  { name: 'dashboard', ms: 51, icon: 'grid' },
  { name: 'reports', ms: 47, icon: 'chart' },
] as const;
---

<div class="bg-lcd-3 lcd-grid text-lcd-0 font-pixel relative h-full overflow-hidden" aria-hidden="true">
  {
    art === 'code' && (
      <div class="h-full p-4">
        <div class="bg-lcd-0 text-lcd-3 hud flex items-center gap-2 px-3 py-1.5 text-[10px]">
          <span class="bg-lcd-3 size-1.5" />
          <span class="bg-lcd-3 size-1.5" />
          <span class="bg-lcd-3 size-1.5" />
          <span class="ml-2">UserCard.tsx</span>
        </div>
        <div class="space-y-2.5 pt-4">
          {codeLines.map((line, index) => (
            <div class:list={['flex items-center gap-3', line.flagged && 'bg-lcd-2 -mx-2 px-2 py-0.5']}>
              <span class="text-lcd-1 w-4 text-right text-[11px]">{index + 1}</span>
              <div class="flex gap-2" style={`padding-left: ${line.indent * 14}px`}>
                {line.parts.map(([tone, width]) => (
                  <span class="h-2" style={`background: ${shade[tone]}; width: ${width * 2.6}px`} />
                ))}
              </div>
            </div>
          ))}
        </div>
        <div class="bg-lcd-0 text-lcd-3 absolute right-3 bottom-3 w-44 p-3">
          <p class="hud flex items-center gap-2 text-[10px]">
            <PixelIcon name="spark" scale={2} className="text-lcd-2" />
            AI review · 2
          </p>
          <div class="mt-2 space-y-1.5">
            <span class="bg-lcd-1 block h-1.5 w-full" />
            <span class="bg-lcd-1 block h-1.5 w-4/5" />
            <span class="bg-lcd-2 block h-1.5 w-3/5" />
          </div>
        </div>
      </div>
    )
  }

  {
    art === 'mobile' && (
      <div class="flex h-full items-start justify-center pt-4">
        <div class="bg-lcd-0 w-40 px-3 pt-5 pb-4">
          <span class="bg-lcd-1 mx-auto mb-3 block h-1.5 w-10" />
          <p class="text-lcd-2 hud text-[9px]">Balance</p>
          <p class="text-lcd-3 text-lg font-bold tabular-nums">$ 12.480</p>
          <div class="bg-lcd-1 mt-2 flex h-16 items-end gap-1 p-1.5">
            {bars.map((height, index) => (
              <span class:list={['flex-1', index === bars.length - 2 ? 'bg-lcd-3' : 'bg-lcd-2']} style={`height: ${height}%`} />
            ))}
          </div>
          <div class="mt-2 space-y-1.5">
            {[0, 1, 2].map(() => (
              <div class="bg-lcd-1 flex items-center gap-2 p-1.5">
                <span class="bg-lcd-2 size-3" />
                <span class="bg-lcd-3/60 h-1.5 flex-1" />
              </div>
            ))}
          </div>
        </div>
        <div class="bg-lcd-0 text-lcd-3 hud absolute top-4 right-3 flex items-center gap-2 px-2.5 py-1.5 text-[10px]">
          <PixelIcon name="spark" scale={2} className="text-lcd-2" />
          AI · 94%
        </div>
      </div>
    )
  }

  {
    art === 'modules' && (
      <div class="h-full p-4">
        <div class="bg-lcd-0 text-lcd-3 flex items-center justify-between px-3 py-2">
          <span class="hud flex items-center gap-2 text-[10px]">
            <PixelIcon name="boxes" scale={2} className="text-lcd-2" />
            host-shell
          </span>
          <span class="bg-lcd-2 text-lcd-0 hud px-1.5 py-0.5 text-[9px]">-90% load</span>
        </div>
        <div class="mt-3 grid grid-cols-2 gap-2.5">
          {modules.map(({ name, ms, icon }) => (
            <div class="bg-lcd-2 p-2.5">
              <div class="flex items-center justify-between">
                <PixelIcon name={icon} scale={2} />
                <span class="text-[11px] tabular-nums">{ms} ms</span>
              </div>
              <p class="mt-1.5 text-[12px] font-semibold">@mfe/{name}</p>
              <span class="bg-lcd-1 mt-1.5 block h-1.5">
                <span class="bg-lcd-0 block h-full" style={`width: ${100 - ms}%`} />
              </span>
            </div>
          ))}
        </div>
      </div>
    )
  }
</div>
