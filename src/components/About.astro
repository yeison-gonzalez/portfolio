---
import SectionHeading from './SectionHeading.astro';
import PixelIcon from './icons/PixelIcon';
import { experience } from '@/data/experience';
import { profile, strengths } from '@/data/profile';
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const currentRole = experience[0].roles[0].title;

// Dialog pages: the quote, then each paragraph of the bio.
const pages = [profile.quote[lang], ...profile.bio[lang]];

const stats = [
  { label: t('about.class'), value: profile.roles[0] },
  { label: t('about.level'), value: currentRole },
  { label: t('about.fact.experience'), value: `${profile.stats.years}+ ${t('about.fact.years')}` },
  { label: t('about.fact.performance'), value: `+${profile.stats.performance}% ${t('about.fact.performanceValue')}` },
  { label: t('about.fact.team'), value: `${profile.stats.teamSize} ${t('about.fact.teamValue')}` },
  { label: t('about.location'), value: profile.location[lang] },
  {
    label: t('about.languages'),
    value: profile.languages.map(({ name, level }) => `${name[lang]} · ${level[lang]}`).join(' / '),
  },
];
---

<section id="about" data-enter="dialog" class="bg-lcd-3 lcd-grid text-lcd-0 py-24 md:py-32">
  <div class="container-page">
    <SectionHeading title={t('about.title')} highlight={t('about.titleHighlight')} />

    <div class="grid gap-12 lg:grid-cols-[1.3fr_1fr] lg:gap-14">
      <!-- RPG dialog: one page per line of the bio, typed out, advanced with ▼ / click / Enter -->
      <div class="enter-box bg-lcd-3 pixel-box relative flex min-h-[19rem] flex-col self-start p-6 md:p-8" style="--frame: var(--color-lcd-0)" data-dialog>
        <div aria-live="polite">
        {
          pages.map((page, index) => (
            <p
              data-page={index}
              hidden={index !== 0}
              class:list={[
                'max-w-[58ch]',
                index === 0 ? 'font-pixel text-2xl leading-snug font-semibold md:text-3xl' : 'text-xl leading-relaxed md:text-[1.45rem]',
              ]}
            >
              <span class="sr-only">{page}</span>
              <span data-type aria-hidden="true">{page}</span><span
                class="bg-lcd-0 animate-blink ml-1 inline-block h-[0.9em] w-[0.5em] translate-y-[0.1em]"
                aria-hidden="true"></span>
            </p>
          ))
        }
        </div>
        <div class="mt-auto flex items-center justify-between gap-4 pt-8">
          <p class="hud text-lcd-1 text-[11px] tabular-nums">
            {t('about.page')} <span data-page-number>1</span>/{pages.length}
          </p>
          <button
            type="button"
            data-next
            data-label-next={t('about.next')}
            data-label-restart={t('about.restart')}
            class="hud bg-lcd-0 text-lcd-3 hover:bg-lcd-1 flex items-center gap-2 px-3 py-2 text-[12px]"
          >
            <span data-next-label>{t('about.next')}</span>
            <PixelIcon name="down" scale={2} className="animate-blink" />
          </button>
        </div>
      </div>

      <!-- Status screen -->
      <div class="pixel-box bg-lcd-3 self-start" style="--frame: var(--color-lcd-0)">
        <p class="bg-lcd-0 text-lcd-3 hud flex items-center justify-between px-5 py-3 text-xs">
          {t('about.stats')}
          <span class="text-lcd-2">{profile.initials}</span>
        </p>
        <dl class="px-5 py-2">
          {
            stats.map(({ label, value }) => (
              <div class="border-lcd-2 grid grid-cols-[7rem_1fr] gap-3 border-b-2 border-dashed py-3 last:border-b-0 sm:grid-cols-[8.5rem_1fr]">
                <dt class="hud text-lcd-1 pt-0.5 text-[12px]">{label}</dt>
                <dd class="text-[18px] leading-snug">{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <!-- Move list: pick a strength to read it in the box -->
    <h3 class="mt-24 text-2xl font-bold md:text-3xl">{t('about.strengths')}</h3>
    <div class="mt-8 grid gap-10 md:grid-cols-[minmax(0,20rem)_1fr]" data-moves>
      <ul class="pixel-box bg-lcd-3 self-start p-3" style="--frame: var(--color-lcd-0)" role="tablist" aria-orientation="vertical">
        {
          strengths.map(({ title }, index) => (
            <li role="presentation">
              <button
                type="button"
                role="tab"
                id={`move-tab-${index}`}
                aria-controls={`move-panel-${index}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? 0 : -1}
                data-move={index}
                class="group aria-selected:bg-lcd-0 aria-selected:text-lcd-3 hud flex w-full items-center gap-3 px-3 py-3 text-left text-[13px]"
              >
                <PixelIcon name="cursor" scale={2} className="opacity-0 group-hover:opacity-100 group-aria-selected:opacity-100" />
                {title[lang]}
              </button>
            </li>
          ))
        }
      </ul>
      <div class="pixel-box bg-lcd-0 text-lcd-3 relative min-h-44 p-6 md:p-8" style="--frame: var(--color-lcd-1)">
        {
          strengths.map(({ title, description }, index) => (
            <div role="tabpanel" id={`move-panel-${index}`} aria-labelledby={`move-tab-${index}`} hidden={index !== 0}>
              <p class="text-lcd-2 font-pixel text-2xl font-bold">{title[lang]}</p>
              <p class="mt-3 max-w-[56ch] text-lg leading-relaxed">{description[lang]}</p>
            </div>
          ))
        }
        <PixelIcon name="down" scale={3} className="animate-blink text-lcd-2 absolute right-5 bottom-4" />
      </div>
    </div>
  </div>
</section>

<script>
  // RPG dialog: type each page out; ▼ / click / Enter moves to the next page, the last one starts over.
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-dialog]').forEach((dialog) => {
    const pages = [...dialog.querySelectorAll<HTMLElement>('[data-page]')];
    const texts = pages.map((page) => page.querySelector<HTMLElement>('[data-type]')?.textContent ?? '');
    const next = dialog.querySelector<HTMLButtonElement>('[data-next]');
    const nextLabel = dialog.querySelector<HTMLElement>('[data-next-label]');
    const number = dialog.querySelector<HTMLElement>('[data-page-number]');
    const section = dialog.closest('[data-enter]');
    let current = 0;
    let timer = 0;

    const type = (index: number) => {
      const target = pages[index].querySelector<HTMLElement>('[data-type]');
      if (!target) return;
      window.clearInterval(timer);
      if (reducedMotion) {
        target.textContent = texts[index];
        return;
      }
      let count = 0;
      target.textContent = '';
      timer = window.setInterval(() => {
        count += 2;
        target.textContent = texts[index].slice(0, count);
        if (count >= texts[index].length) window.clearInterval(timer);
      }, 30);
    };

    const show = (index: number) => {
      current = (index + pages.length) % pages.length;
      pages.forEach((page, i) => (page.hidden = i !== current));
      if (number) number.textContent = String(current + 1);
      if (nextLabel && next) {
        nextLabel.textContent = current === pages.length - 1 ? (next.dataset.labelRestart ?? '') : (next.dataset.labelNext ?? '');
      }
      type(current);
    };

    next?.addEventListener('click', (event) => {
      event.stopPropagation();
      show(current + 1);
    });
    dialog.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a, button')) return;
      show(current + 1);
    });

    // Type the first page once the section has entered.
    if (!reducedMotion && section) {
      const first = pages[0].querySelector<HTMLElement>('[data-type]');
      if (first) first.textContent = '';
      let started = false;
      new MutationObserver(() => {
        if (started || !section.classList.contains('is-in')) return;
        started = true;
        window.setTimeout(() => type(0), 380);
      }).observe(section, { attributes: true, attributeFilter: ['class'] });
    }
  });

  // Move list: a vertical tablist driven by click and arrow keys.
  document.querySelectorAll<HTMLElement>('[data-moves]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-move]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
      panels.forEach((panel, i) => (panel.hidden = i !== index));
      if (focus) tabs[index].focus();
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index));
      tab.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowDown' ? 1 : event.key === 'ArrowUp' ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        select((index + step + tabs.length) % tabs.length, true);
      });
    });
  });
</script>
