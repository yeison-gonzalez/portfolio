---
import '@/styles/global.css';
import { education } from '@/data/education';
import { profile } from '@/data/profile';
import { allSkills } from '@/data/skills';
import { languages, type Lang } from '@/i18n/ui';
import { getHomeUrl, useTranslations } from '@/i18n/utils';
import { withBase } from '@/lib/url';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Emit hreflang alternates (only for pages that exist in every language). */
  alternates?: boolean;
  noindex?: boolean;
}

const { lang, title, description, alternates = true, noindex = false } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ?? t('meta.title');
const pageDescription = description ?? t('meta.description');
const site = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(withBase('og-image.png'), site).href;
const locales = Object.keys(languages) as Lang[];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.fullName,
  alternateName: profile.name,
  jobTitle: profile.role[lang],
  url: new URL(getHomeUrl(lang), site).href,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Bogotá', addressCountry: 'CO' },
  // Schools only: course providers (the AI certificates) are not alma maters.
  alumniOf: [...new Set(education.filter((item) => item.kind !== 'ai').map((item) => item.institution[lang]))].map((name) => ({
    '@type': 'EducationalOrganization',
    name,
  })),
  knowsAbout: allSkills.map((skill) => skill.name),
  knowsLanguage: ['es', 'en'],
  sameAs: Object.values(profile.socials),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={profile.fullName} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      alternates &&
        locales.map((locale) => (
          <link rel="alternate" hreflang={locale} href={new URL(getHomeUrl(locale), site).href} />
        ))
    }
    {alternates && <link rel="alternate" hreflang="x-default" href={new URL(getHomeUrl('es'), site).href} />}

    <link rel="icon" type="image/png" href={withBase('favicon.png')} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    <meta name="theme-color" content="#0f380f" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- Section entrances only hide content when JS is running. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-dvh overflow-x-clip">
    <a
      href="#main"
      class="bg-magenta text-lcd-3 hud sr-only fixed top-3 left-3 z-100 px-4 py-2 text-sm focus:not-sr-only"
    >
      {t('nav.skip')}
    </a>

    <slot />

    <script>
      // Each `[data-enter]` section plays its own entrance once, when it scrolls into view.
      const enterObserver = new IntersectionObserver(
        (entries, observer) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-in');
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -15% 0px', threshold: 0.05 },
      );
      document.querySelectorAll('[data-enter]').forEach((section) => enterObserver.observe(section));

      // Live local time in Bogotá for every `[data-local-time]` element.
      const clocks = document.querySelectorAll<HTMLElement>('[data-local-time]');
      if (clocks.length) {
        const format = new Intl.DateTimeFormat(document.documentElement.lang, {
          timeZone: 'America/Bogota',
          hour: 'numeric',
          minute: '2-digit',
        });
        const tick = () => {
          const now = format.format(new Date());
          clocks.forEach((clock) => (clock.textContent = now));
        };
        tick();
        window.setInterval(tick, 15_000);
      }
    </script>
  </body>
</html>
